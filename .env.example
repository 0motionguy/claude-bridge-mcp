# Claude Bridge MCP Configuration
# Copy to .env and customize

# Server
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3100

# Security (optional — if unset, IP allowlist only)
BRIDGE_API_TOKEN=

# IP Allowlist (comma-separated, empty = allow all)
# Find your Tailscale IP: tailscale ip -4
BRIDGE_ALLOWED_IPS=

# Directory Allowlist (comma-separated, empty = current working dir)
BRIDGE_ALLOWED_DIRS=

# Performance
BRIDGE_TIMEOUT=120000
BRIDGE_MAX_CONCURRENT=2
BRIDGE_QUEUE_TIMEOUT=30000
